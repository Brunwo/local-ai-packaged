# Global options - works for both environments
{
	email {$LETSENCRYPT_EMAIL}
}

# Open WebUI - Frontend UI
{$WEBUI_HOSTNAME}, www.{$WEBUI_HOSTNAME} {
	# Automatic HTTPS with Let's Encrypt for both domains
	reverse_proxy open-webui:8080
}

# LiteLLM API - Restricted to your IP only
litellm.{$WEBUI_HOSTNAME} {
	# Use the same certificate as the main domain
	tls {$LETSENCRYPT_EMAIL}

	# Trust Cloudflare proxy headers to get real client IP
	request_header CF-Connecting-IP {header.CF-Connecting-IP}
	request_header X-Forwarded-For {header.X-Forwarded-For}
	request_header X-Real-IP {header.X-Real-IP}

	# IP restriction - only allow configured IPs (using real IP from Cloudflare)
	@allowed {
		header CF-Connecting-IP {$ALLOWED_IP}
	}
	@blocked not {
		header CF-Connecting-IP {$ALLOWED_IP}
	}

	respond @blocked 403 {
		body "Access denied. This service is restricted to authorized IPs only."
	}

	# Reverse proxy to LiteLLM service
	reverse_proxy @allowed litellm:4000
}

